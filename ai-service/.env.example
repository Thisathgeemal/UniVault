# ai-service (Flask): copy to ai-service/.env and adjust. Never commit ai-service/.env.

# Port the Flask anomaly detection service listens on (backend AI_SERVICE_URL must match).
FLASK_PORT=5001

# Path to the trained Isolation Forest model file, relative to ai-service/.
# Model files (*.joblib, *.pkl) are gitignored.
MODEL_PATH=./models/isolation_forest.joblib

# Anomaly score above which a verification event is flagged as suspicious.
# Placeholder: calibrate once the model is trained and its score scale is fixed.
ANOMALY_THRESHOLD=0.5
