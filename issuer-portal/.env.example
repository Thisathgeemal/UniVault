# issuer-portal: copy to issuer-portal/.env (or .env.local) and adjust.
# WARNING: every VITE_* variable is bundled into the browser JavaScript and is PUBLIC.
# Never put secrets (API keys, JWT secrets, passwords, private keys) in a VITE_ variable.

# Base URL of the UniVault backend API, including /api/v1. Its origin is also added to the
# production Content-Security-Policy (connect-src). Default: http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
