{
  "name": "@univault/issuer-portal",
  "version": "0.1.0",
  "private": true,
  "description": "UniVault issuer portal (React + Vite): staff sign-in and the issuer application",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build:deps": "npm --prefix ../portal-ui run build && npm --prefix ../claims-validation run build",
    "predev": "npm run build:deps",
    "dev": "vite",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/check-production-bundle.mjs",
    "preview": "vite preview",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:deps",
    "test": "vitest run",
    "pretest:coverage": "npm run build:deps",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build:deps",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-sinhala": "5.3.0",
    "@tanstack/react-query": "5.108.4",
    "@univault/claims-validation": "file:../claims-validation",
    "@univault/portal-ui": "file:../portal-ui",
    "i18next": "27.2.7",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "31.0.1",
    "jsqr": "1.4.0",
    "msw": "3.0.7",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.19",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.5",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
