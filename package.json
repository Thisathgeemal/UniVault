{
  "name": "univault",
  "version": "0.1.0",
  "private": true,
  "description": "UniVault: privacy-preserving self-sovereign identity wallet (final year project monorepo)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-secrets.js",
    "seed:generate": "node scripts/generate-synthetic-data.mjs && prettier --write backend/seed-data"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@sd-jwt/core": "0.25.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "node-forge": "1.4.3",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
