# UniVault backend: copy to backend/.env and fill in. Never commit backend/.env.

# Port the Express API listens on.
PORT=4000

# Runtime mode: development | test | production.
NODE_ENV=development

# Log detail: fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Maximum size of a JSON request body
REQUEST_BODY_LIMIT=100kb

# Database connection string, e.g. <driver>://<user>:<password>@localhost:<port>/univault
# Put the real credentials only in your local .env.
# Empty = embedded PostgreSQL (PGlite) at pglite://./.data/univault. Production requires postgres://.
DATABASE_URL=

# Apply new SQL migrations automatically when the server starts (true | false).
DB_AUTO_MIGRATE=true

# Secret used to sign backend session/auth JWTs (NOT the credential-signing keys).
# Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Directory holding issuer key files (<kid>.private.pem encrypted, <kid>.public.jwk.json).
# Relative to backend/. This folder is gitignored; never commit keys.
ISSUER_KEYS_DIR=./keys

# Passphrase that encrypts issuer private keys at rest (min 12 characters).
# The value below is for DEVELOPMENT ONLY: production refuses it, and requires at least
# 20 characters. Set the real value as a host secret; never commit it.
ISSUER_KEY_PASSPHRASE=univault-dev-key-passphrase-change-me

# Where issuer private keys are loaded from (docs/security/issuer-key-management.md):
#   file (default) = encrypted PKCS#8 files in ISSUER_KEYS_DIR
#   env            = ISSUER_KEYS_BUNDLE, for hosts with an ephemeral filesystem
# Unencrypted keys are refused in both modes. In env mode keys cannot be rotated through the
# API (409): generate locally, run `npm run keys:bundle`, update the secret and redeploy.
ISSUER_KEY_SOURCE=file

# env mode only: base64 bundle of the ENCRYPTED keys, written by `npm run keys:bundle` to
# keys/issuer-keys.bundle.b64. Set it as a host secret (required in production with env mode).
# Leave empty here; never commit or paste the bundle.
ISSUER_KEYS_BUNDLE=

# true = refuse to start if any active issuer key fails its start-up check (decrypt, kid,
# public key). Always true in production (false is refused there); default false elsewhere,
# where the server starts degraded and only the affected issuer's signing fails (503).
ISSUER_KEYS_STRICT_STARTUP=

# Seconds a failed issuer key load is remembered: signings in that window answer 503 at once
# without decrypting again; the next one after it retries. Rotation clears it. 0 = always retry.
KEY_RETRY_BACKOFF_SECONDS=30

# Public URL where wallets and verifiers reach this API (used in QR codes and credential
# offers). For phone testing, use the laptop's LAN IP, e.g. http://<your-lan-ip>:4000
# Must be https:// in production: it is the OpenID4VCI credential_issuer of every offer
PUBLIC_BASE_URL=http://localhost:4000

# Comma-separated browser origins allowed by CORS (issuer portal, verifier portal).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Base URL of the Python/Flask AI anomaly detection service.
AI_SERVICE_URL=http://localhost:5001

# How long (ms) to wait for the AI service before giving up on a request.
AI_SERVICE_TIMEOUT_MS=3000

# How long (seconds) a credential offer / issuance QR code stays valid (5 minutes).
CREDENTIAL_OFFER_TTL_SECONDS=300

# How long (seconds) a verifier's presentation request / verification session stays valid.
VERIFICATION_SESSION_TTL_SECONDS=300

# Login token lifetime in seconds (300–86400)
JWT_EXPIRES_IN_SECONDS=3600
# Lock an account for LOGIN_LOCKOUT_MINUTES after this many wrong passwords
LOGIN_MAX_FAILED_ATTEMPTS=5
# How long (minutes) a locked account stays locked
LOGIN_LOCKOUT_MINUTES=15
# Maximum login attempts per IP address per window
LOGIN_RATE_LIMIT_MAX=20
# Length (minutes) of the login rate-limit window
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Folder with the credential JSON Schemas. Empty = <repo>/docs/schemas (the default).
CREDENTIAL_SCHEMAS_DIR=

# Public credential status endpoint GET /api/v1/status/:credentialId (no login; verifiers):
# at most STATUS_RATE_LIMIT_MAX requests per client IP per STATUS_RATE_LIMIT_WINDOW_MINUTES,
# then 429 RATE_LIMITED. Defaults: 60 per 1 minute.
STATUS_RATE_LIMIT_MAX=60
STATUS_RATE_LIMIT_WINDOW_MINUTES=1

# Password for the seeded development staff logins (npm run db:seed / db:reset; min 10 characters).
# Empty = the documented default development password. Development data only.
SEED_STAFF_PASSWORD=

# dev/evidence only – remove in Sprint 2 when wallet redemption ships.
# true | false (default false). Mounts POST /api/v1/dev/credentials/:id/simulate-redemption
# (signs a pending credential with a throwaway wallet key) and
# POST /api/v1/dev/credentials/:id/simulate-expiry (moves a valid credential's expiry one
# minute into the past). Used by scripts/evidence/s1-revocation.ps1 and s1-status.ps1. The
# server logs a warning at start-up when it is enabled, and refuses to start with it in
# production.
DEV_SIMULATE_REDEMPTION=false
