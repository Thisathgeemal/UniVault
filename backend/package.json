{
  "name": "@univault/backend",
  "version": "0.1.0",
  "private": true,
  "description": "UniVault backend API (Node.js + Express)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:deps": "npm --prefix ../crypto-core run build",
    "predev": "npm run build:deps",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:deps",
    "test": "vitest run",
    "pretest:coverage": "npm run build:deps",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:inspect": "tsx src/db/cli.ts inspect",
    "db:reset": "tsx src/db/cli.ts reset",
    "prekeys:init": "npm run build:deps",
    "keys:init": "tsx src/db/cli.ts keys"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@univault/crypto-core": "file:../crypto-core",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.28.2",
    "@rolldown/binding-win32-x64-msvc": "1.2.19"
  }
}
