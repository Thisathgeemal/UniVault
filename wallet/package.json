{
  "name": "@univault/wallet",
  "version": "0.1.0",
  "private": true,
  "description": "UniVault mobile wallet (React Native + Expo): holders store and present SD-JWT credentials",
  "main": "index.ts",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build:deps": "npm --prefix ../crypto-core run build",
    "prestart": "npm run build:deps",
    "start": "expo start",
    "prestart:tunnel": "npm run build:deps",
    "start:tunnel": "expo start --tunnel ngrok",
    "preandroid": "npm run build:deps",
    "android": "expo start --android",
    "preios": "npm run build:deps",
    "ios": "expo start --ios",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "cd .. && eslint --max-warnings 0 wallet",
    "pretest": "npm run build:deps",
    "test": "jest",
    "pretest:coverage": "npm run build:deps",
    "test:coverage": "jest --coverage",
    "doctor": "npx expo-doctor",
    "fixture:diagnostics": "npm --prefix ../crypto-core run build && node scripts/make-diagnostics-fixture.mjs",
    "art:placeholder": "node scripts/make-placeholder-art.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-sinhala": "0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@univault/crypto-core": "file:../crypto-core",
    "expo": "58.1.0",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.9",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.33",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.15",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "i18next": "27.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "18.0.3",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.3",
    "jest": "30.5.2",
    "jest-expo": "58.0.16",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@expo/modules-macros-win32-x64": "0.33.0",
    "@expo/ngrok-bin-win32-x64": "2.3.41",
    "@noxcturnal/noxcturnal-win32-x64-msvc": "0.1.14",
    "@parcel/watcher-win32-x64": "2.6.0",
    "@unrs/resolver-binding-win32-x64-msvc": "1.13.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
