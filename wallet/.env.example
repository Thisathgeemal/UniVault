# wallet (Expo): copy to wallet/.env and adjust.
# WARNING: every EXPO_PUBLIC_* variable is bundled into the app and is PUBLIC.
# Never put secrets (API keys, JWT secrets, private keys) in this file.

# Base URL of the UniVault backend API, as reachable FROM THE PHONE.
# Use the laptop's LAN IP (e.g. from `ipconfig` / `ipconfig getifaddr en0`), not localhost:
# on a phone, "localhost" is the phone itself. Phone and laptop must be on the same Wi-Fi.
EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:4000
