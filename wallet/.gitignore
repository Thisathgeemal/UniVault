# Expo / React Native (in addition to the repository .gitignore)

# Native projects are generated by `npx expo prebuild` (Continuous Native Generation): never commit
/android
/ios

# Expo and Metro caches and generated types
.expo/
.metro-health-check*
expo-env.d.ts.bak

# Builds and test output
dist/
web-build/
coverage/
*.tsbuildinfo

# Signing material (also covered at the root)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Local environment (wallet/.env.example stays tracked)
.env
.env.*
!.env.example
